# Copia aquest fitxer a .env i posa-hi els valors reals:
#   cp .env.example .env
# El fitxer .env NO es puja a GitHub.

# Serveis que s'arrenquen en aquest servidor
#   MVP (tot en una VM):  dmz,bbdd,intranet
#   Dockers-DMZ:          dmz
#   Docker-B-NCC:         bbdd
#   Dockers-Intranet:     intranet
COMPOSE_PROFILES=dmz,bbdd,intranet

# --- BBDD ---
MYSQL_ROOT_PASSWORD=canvia_aquesta_clau
# Usuari de només lectura de l'aplicació web
WEBAPP_PASSWORD=canvia_aquesta_clau
# Des d'on es pot connectar l'usuari webapp
#   MVP:   %            (qualsevol contenidor de la mateixa VM)
#   Final: 172.29.89.1  (només el servidor de la DMZ)
WEBAPP_HOST=%
# IP on s'obre el port 3306
#   MVP:   127.0.0.1    (només la mateixa VM)
#   Final: 172.29.89.10 (només la xarxa aïllada de la BBDD)
DB_BIND_IP=127.0.0.1

# --- FTP ---
# IP que l'FTP anuncia en mode passiu
FTP_ADDRESS=172.29.88.10
